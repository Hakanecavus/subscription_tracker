# Copy this file to .env and fill in your values

# App Configuration
APP_NAME=Subscription Tracker
APP_VERSION=1.0.0

# Database Configuration
DB_VERSION=1
DB_ENCRYPTION_KEY=your_encryption_key_here

# Security
BIOMETRIC_REQUIRED=false
PIN_LENGTH=4

# Notifications
NOTIFICATION_CHANNEL_ID=subscription_reminders
NOTIFICATION_CHANNEL_NAME=Subscription Reminders

# Features
ENABLE_ANALYTICS=true
ENABLE_BACKUP=true
ENABLE_BIOMETRIC=true
